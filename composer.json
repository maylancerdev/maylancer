{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "repositories": [
        {
            "type": "composer",
            "url": "https://satis.spatie.be"
        },
        {
            "type": "vcs",
            "url": "git@github.com:donejeh/nuban-api.git"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "blade-ui-kit/blade-heroicons": "^2.6",
        "czproject/git-php": "^4.3",
        "davidhsianturi/blade-bootstrap-icons": "^2.2",
        "erusev/parsedown": "^1.7",
        "erusev/parsedown-extra": "^0.8.1",
        "filament/filament": "^5.0",
        "graham-campbell/markdown": "^16.0",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^11.0",
        "laravel/tinker": "^3.0",
        "league/commonmark": "^2.4",
        "livewire/livewire": "^4.3",
        "mailchimp/marketing": "^3.0",
        "owenvoke/blade-fontawesome": "^3.2",
        "spatie/fork": "^1.1",
        "spatie/laravel-markdown": "^2.7",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-tags": "^4.10",
        "spatie/sheets": "^1.10",
        "spatie/shiki-php": "^2.2",
        "spatie/valuestore": "^1.3",
        "symfony/dom-crawler": "^7.0",
        "tempest/highlight": "^2.0",
        "torchlight/torchlight-commonmark": "^0.6",
        "torchlight/torchlight-laravel": "^0.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.0",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.34",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "setup": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "php artisan key:generate",
            "php artisan migrate --seed"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
